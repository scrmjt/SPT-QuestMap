@using System.Linq
@using SPTQuestMap.Core.Rules

<aside class="coop-panel @(Expanded ? "expanded" : null)" aria-label="@Localizer["coop.title"]">
    <button class="coop-toggle" type="button" aria-expanded="@Expanded.ToString().ToLowerInvariant()" title="@Localizer["coop.title"]" @onclick="() => ExpandedChanged.InvokeAsync(!Expanded)">
        <span class="coop-title">@Localizer["coop.title"]</span><span class="coop-chevron" aria-hidden="true">@(Expanded ? "‹" : "›")</span>
    </button>
    <div class="coop-content">
        <label class="coop-picker">
            <span class="sr-only">@Localizer["coop.pick"]</span>
            <FilterDropdown Items="@ProfileItems()"
                            Selected="@State.PoolProfileIds"
                            AllLabel="@Localizer["coop.pick"]"
                            SearchPlaceholder="@Localizer["coop.search"]"
                            SelectAllLabel="@Localizer["filter.selectAll"]"
                            ClearLabel="@Localizer["filter.clear"]"
                            SelectedCountFormat="@Localizer["coop.selectedCount"]"
                            CloseLabel="@Localizer["filter.close"]"
                            SelectionChanged="PoolChanged" />
        </label>

        @if (State.PoolProfiles.Count == 0)
        {
            <p class="coop-empty">@Localizer["coop.none"]</p>
        }
        else if (State.CoopMapRows.Count == 0)
        {
            <p class="coop-empty">@Localizer["coop.noWork"]</p>
        }
        else
        {
            <div class="coop-table-scroll">
                <table class="coop-table">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["map.label"]</th>
                            @foreach (var profile in State.PoolProfiles)
                            {
                                <th scope="col" title="@profile.Nickname">@State.PoolProfileLabel(profile.ProfileId)</th>
                            }
                            <th scope="col" class="coop-shared-col" title="@Localizer["coop.shared.detail"]">@Localizer["coop.shared"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in State.CoopMapRows)
                        {
                            <tr class="@(row.SharedByAll > 0 ? "has-shared" : null)">
                                <th scope="row">@row.MapName</th>
                                @foreach (var count in row.PerProfile)
                                {
                                    var unique = row.UniqueToProfile.FirstOrDefault(entry => entry.ProfileId == count.ProfileId)?.QuestIds.Count ?? 0;
                                    var behind = State.CoopBehind(row, count.ProfileId);
                                    <td class="@(unique == 0 ? "zero" : null)" title="@CellTooltip(row, count, unique)">
                                        @unique
                                        @if (behind.Count > 0)
                                        {
                                            <span class="coop-behind" title="@BehindTooltip(behind)">+@behind.Max(entry => entry.Furthest)</span>
                                        }
                                    </td>
                                }
                                <td class="coop-shared-col @(row.SharedByAll == 0 ? "zero" : null)">@row.SharedByAll</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="coop-footnote">@Localizer["coop.footnote"]</p>
            <p class="coop-footnote">@Localizer["coop.behind.legend"]</p>
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public QuestMapPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public QuestMapLocalizer Localizer { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ProfileSummaryDto> Profiles { get; set; } = default!;
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlySet<string>> PoolChanged { get; set; }

    /// <summary>
    /// The column shows only what is unique to this player here; the total they still have on
    /// the map goes in the tooltip so the number is still reachable.
    /// </summary>
    private string CellTooltip(CoopMapRow row, CoopProfileCount count, int unique)
        => Localizer.Format("coop.cell.unique",
            ("profile", State.PoolProfileLabel(count.ProfileId)),
            ("unique", unique),
            ("total", count.Count),
            ("map", row.MapName));

    /// <summary>
    /// Names the quests each lagging player must finish to reach this player's unique work,
    /// closest first. Capped, because a deep chain would otherwise produce a tooltip taller
    /// than the window.
    /// </summary>
    private string BehindTooltip(IReadOnlyList<CoopBehindDto> behind)
    {
        var lines = new List<string>();
        foreach (var entry in behind)
        {
            lines.Add(Localizer.Format("coop.cell.behind",
                ("profile", entry.Label), ("count", entry.Count), ("steps", entry.Furthest)));
            lines.AddRange(entry.Blocking.Take(BlockingListLimit).Select(name => "  · " + name));
            if (entry.Blocking.Count > BlockingListLimit)
            {
                lines.Add(Localizer.Format("coop.cell.andMore", ("count", entry.Blocking.Count - BlockingListLimit)));
            }
        }
        return string.Join("\n", lines);
    }

    private const int BlockingListLimit = 8;

    private IReadOnlyList<FilterDropdown.FilterDropdownItem> ProfileItems()
        => Profiles
            .Select(profile => new FilterDropdown.FilterDropdownItem(
                profile.Id,
                $"{profile.Nickname} · {profile.Level}"))
            .ToArray();
}
