@using System.Linq
@using SPTQuestMap.Core.Rules

<aside class="coop-panel @(Expanded ? "expanded" : null)" aria-label="@Localizer["coop.title"]">
    <button class="coop-toggle" type="button" aria-expanded="@Expanded.ToString().ToLowerInvariant()" title="@Localizer["coop.title"]" @onclick="() => ExpandedChanged.InvokeAsync(!Expanded)">
        <span class="coop-title">@Localizer["coop.title"]</span><span class="coop-chevron" aria-hidden="true">@(Expanded ? "‹" : "›")</span>
    </button>
    <div class="coop-content">
        <label class="coop-picker">
            <span class="sr-only">@Localizer["coop.pick"]</span>
            <FilterDropdown Items="@ProfileItems()"
                            Selected="@State.PoolProfileIds"
                            AllLabel="@Localizer["coop.pick"]"
                            SearchPlaceholder="@Localizer["coop.search"]"
                            SelectAllLabel="@Localizer["filter.selectAll"]"
                            ClearLabel="@Localizer["filter.clear"]"
                            SelectedCountFormat="@Localizer["coop.selectedCount"]"
                            CloseLabel="@Localizer["filter.close"]"
                            SelectionChanged="PoolChanged" />
        </label>

        @if (State.PoolProfiles.Count == 0)
        {
            <p class="coop-empty">@Localizer["coop.none"]</p>
        }
        else if (State.CoopMapRows.Count == 0)
        {
            <p class="coop-empty">@Localizer["coop.noWork"]</p>
        }
        else
        {
            <div class="coop-table-scroll">
                <table class="coop-table">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["map.label"]</th>
                            @foreach (var profile in State.PoolProfiles)
                            {
                                <th scope="col" title="@profile.Nickname">@State.PoolProfileLabel(profile.ProfileId)</th>
                            }
                            <th scope="col" class="coop-shared-col" title="@Localizer["coop.shared.detail"]">@Localizer["coop.shared"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in State.CoopMapRows)
                        {
                            <tr class="@(row.SharedByAll > 0 ? "has-shared" : null)">
                                <th scope="row">
                                    <button type="button" class="coop-map-link" title="@Localizer["coop.map.filterHint"]"
                                            @onclick="() => MapFilterRequested.InvokeAsync(row.MapId)">@row.MapName</button>
                                </th>
                                @foreach (var count in row.PerProfile)
                                {
                                    var unique = row.UniqueToProfile.FirstOrDefault(entry => entry.ProfileId == count.ProfileId)?.QuestIds.Count ?? 0;
                                    var behind = State.CoopBehind(row, count.ProfileId);
                                    <td class="@(unique == 0 ? "zero" : null)" title="@CellTooltip(row, count, unique)">
                                        @unique
                                        @if (behind.Count > 0)
                                        {
                                            <button type="button" class="coop-behind"
                                                    @onmouseenter="() => ShowDetail(row, behind)"
                                                    @onfocus="() => ShowDetail(row, behind)"
                                                    @onclick="() => ShowDetail(row, behind)">+@behind.Max(entry => entry.Furthest)</button>
                                        }
                                    </td>
                                }
                                <td class="coop-shared-col @(row.SharedByAll == 0 ? "zero" : null)">
                                    @if (row.SharedByAll > 0)
                                    {
                                        <button type="button" class="coop-shared-link"
                                                @onmouseenter="() => ShowShared(row)"
                                                @onfocus="() => ShowShared(row)"
                                                @onclick="() => ShowShared(row)">@row.SharedByAll</button>
                                    }
                                    else
                                    {
                                        @row.SharedByAll
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_detail is not null)
            {
                <div class="coop-detail">
                    <div class="coop-detail-head">
                        <strong>@_detail.MapName</strong>
                        <button type="button" class="coop-detail-close" @onclick="() => _detail = null">@Localizer["filter.close"]</button>
                    </div>
                    @foreach (var part in _detail.Sections)
                    {
                        <p class="coop-detail-lead">@part.Label</p>
                        <ol class="coop-detail-quests">
                            @foreach (var quest in part.Quests.Take(BlockingListLimit))
                            {
                                <li>
                                    <button type="button" @onclick="() => QuestSelected.InvokeAsync(quest.QuestId)">@quest.Name</button>
                                </li>
                            }
                        </ol>
                        @if (part.Quests.Count > BlockingListLimit)
                        {
                            <p class="coop-detail-more">@Localizer.Format("coop.cell.andMore", ("count", part.Quests.Count - BlockingListLimit))</p>
                        }
                    }
                </div>
            }
            <p class="coop-footnote">@Localizer["coop.footnote"]</p>
            <p class="coop-footnote">@Localizer["coop.behind.legend"]</p>
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public QuestMapPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public QuestMapLocalizer Localizer { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<ProfileSummaryDto> Profiles { get; set; } = default!;
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlySet<string>> PoolChanged { get; set; }

    /// <summary>Raised with a map id when a map name is clicked, to filter the graph to it.</summary>
    [Parameter] public EventCallback<string> MapFilterRequested { get; set; }

    /// <summary>Raised with a quest id when a quest name is clicked, to select it on the graph.</summary>
    [Parameter] public EventCallback<string> QuestSelected { get; set; }

    /// <summary>
    /// The column shows only what is unique to this player here; the total they still have on
    /// the map goes in the tooltip so the number is still reachable.
    /// </summary>
    private string CellTooltip(CoopMapRow row, CoopProfileCount count, int unique)
        => Localizer.Format("coop.cell.unique",
            ("profile", State.PoolProfileLabel(count.ProfileId)),
            ("unique", unique),
            ("total", count.Count),
            ("map", row.MapName));

    /// <summary>
    /// Fills the detail block under the table. Replaces a native `title`: it carried newlines,
    /// which browsers render inconsistently, and it was clipped by the table's own horizontal
    /// scroller. A block below the table cannot be clipped and needs no positioning maths.
    /// </summary>
    private void ShowDetail(CoopMapRow row, IReadOnlyList<CoopBehindDto> behind)
        => _detail = new PanelDetail(
            row.MapName,
            behind
                .Select(entry => new DetailSection(
                    Localizer.Format("coop.cell.behind", ("profile", entry.Label), ("count", entry.Count), ("steps", entry.Furthest)),
                    entry.Blocking))
                .ToArray());

    /// <summary>The same block, listing the quests every pooled player still needs here.</summary>
    private void ShowShared(CoopMapRow row)
        => _detail = new PanelDetail(
            row.MapName,
            [new DetailSection(Localizer.Format("coop.shared.heading", ("count", row.SharedByAll)), State.CoopSharedQuests(row))]);

    private PanelDetail? _detail;

    private sealed record DetailSection(string Label, IReadOnlyList<QuestRefDto> Quests);

    private sealed record PanelDetail(string MapName, IReadOnlyList<DetailSection> Sections);

    private const int BlockingListLimit = 8;

    private IReadOnlyList<FilterDropdown.FilterDropdownItem> ProfileItems()
        => Profiles
            .Select(profile => new FilterDropdown.FilterDropdownItem(
                profile.Id,
                $"{profile.Nickname} · {profile.Level}"))
            .ToArray();
}
