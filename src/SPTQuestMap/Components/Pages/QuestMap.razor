@page "/questmap"
@layout SPTQuestMap.Components.Layout.QuestMapLayout
@implements IAsyncDisposable
@inject QuestMapDataService DataService
@inject IJSRuntime JavaScript

<HeadContent>
    <title>@(Localizer?["app.title"] ?? "SPT QuestMap")</title>
    <style id="spt-questmap-styles">@((MarkupString)QuestMapEmbeddedAssets.Css)</style>
</HeadContent>

@if (Localizer is not null)
{
    <div class="app-shell">
        <QuestMapHeader Localizer="@Localizer" Profiles="@Profiles" SelectedProfile="@SelectedProfile" SelectedComparisonProfile="@SelectedComparisonProfile" CompareMode="@State.CompareMode" Languages="@Bootstrap!.Languages" Busy="@Busy" RefreshRequested="RefreshAsync" ProfileChanged="ChangeProfileAsync" ComparisonProfileChanged="ChangeComparisonProfileAsync" CompareModeChanged="SetCompareModeAsync" SwapProfilesRequested="SwapProfilesAsync" LanguageChanged="ChangeLanguageAsync">
            <QuestMapFilters State="@State" Localizer="@Localizer" ShowAllFutureChanged="SetShowAllFutureAsync" ShowFinishedChanged="SetShowFinishedAsync" RepeatablesChanged="SetShowRepeatablesAsync" LevelCapChanged="SetLevelCapAsync" ComparisonFilterChanged="SetComparisonFilterAsync" SearchChanged="SetSearchAsync" TraderChanged="SetTraderAsync" MapChanged="SetMapAsync" />
        </QuestMapHeader>
        <main class="workspace">
            <div class="side-views">
                <InProgressDrawer State="@State" Localizer="@Localizer" ExpandedChanged="SetDrawerExpandedAsync" QuestSelected="SelectFromDrawerAsync" />
                <CatchUpPanel State="@State" Localizer="@Localizer" ExpandedChanged="SetCatchUpExpandedAsync" QuestSelected="SelectFromDrawerAsync" TraderFilterRequested="FilterToTraderAsync" MapFilterRequested="FilterToMapAsync" />
                <CoopMapPanel State="@State" Localizer="@Localizer" Profiles="@Profiles" Expanded="@CoopExpanded" ExpandedChanged="SetCoopExpandedAsync" PoolChanged="SetCoopPoolAsync" MapFilterRequested="FilterToMapAsync" />
            </div>
            <section class="viewport @(State.InProgressExpanded ? "progress-panel-open" : null)" aria-label="@Localizer["graph.aria"]" @ref="ViewportElement">
                <canvas id="graph" tabindex="0" aria-label="@Localizer["graph.canvasAria"]" @ref="CanvasElement"></canvas>
                <div class="graph-actions" aria-label="@Localizer["graph.actionsAria"]">
                    <button type="button" title="@Localizer["zoom.in"]" @onclick="() => ZoomAsync(1.22)">+</button><button type="button" title="@Localizer["zoom.out"]" @onclick="() => ZoomAsync(1 / 1.22)">−</button>
                    <button type="button" @onclick="FitAsync">@Localizer["fit"]</button><button type="button" disabled="@(!State.CanFocusSelection || State.FocusedId == State.SelectedId)" @onclick="FocusAsync">@Localizer["focus"]</button>
                    @if (State.FocusMode) { <button type="button" @onclick="ClearFocusAsync">@Localizer["focus.clear"]</button> }
                    <button type="button" disabled="@(State.SelectedId is null)" @onclick="ClearSelectionAsync">@Localizer["selection.clear"]</button>
                </div>
                @if (Busy || !RendererReady || Profiles.Count == 0)
                {
                    <div class="loading-state" role="status">@(Profiles.Count == 0 ? Localizer["profiles.none"] : BusyMessage)</div>
                }
                @if (ErrorMessage is not null)
                {
                    <div class="error-state" role="alert">@ErrorMessage</div>
                }
                <QuestLegend State="@State" Localizer="@Localizer" />
                <div class="metrics" aria-live="polite" @ref="MetricsElement"></div>
            </section>
            <QuestDetails State="@State" Localizer="@Localizer" QuestSelected="SelectRelationAsync" DetailTextTabChanged="SetDetailTextTabAsync" />
        </main>
    </div>
}

@code {
    private readonly QuestMapPageState State = new();
    private QuestMapBootstrapDto? Bootstrap;
    private QuestMapLocalizer? Localizer;
    private IReadOnlyList<ProfileSummaryDto> Profiles = [];
    private ProfileSummaryDto? SelectedProfile;
    private ProfileSummaryDto? SelectedComparisonProfile;
    private ElementReference CanvasElement;
    private ElementReference ViewportElement;
    private ElementReference MetricsElement;
    private IJSObjectReference? Module;
    private DotNetObjectReference<QuestMap>? DotNetReference;
    private bool RendererReady;
    private bool Busy = true;
    private string BusyMessage = string.Empty;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        BusyMessage = "Loading quest topology and profiles…";
        LoadSnapshots(null, null, null, false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Module = await JavaScript.InvokeAsync<IJSObjectReference>("import", QuestMapEmbeddedAssets.RendererModuleDataUrl);
            var settings = await LoadSettingsAsync();
            if (settings is not null)
            {
                LoadSnapshots(settings.Language, settings.SelectedProfileId, settings.ComparisonProfileId, settings.CompareEnabled);
                State.ApplySettings(settings);
                SelectedProfile = Profiles.FirstOrDefault(profile => profile.Id == State.Profile?.ProfileId);
                SelectedComparisonProfile = Profiles.FirstOrDefault(profile => profile.Id == State.ComparisonProfile?.ProfileId)
                    ?? Profiles.FirstOrDefault(profile => profile.Id == settings.ComparisonProfileId && profile.Id != SelectedProfile?.Id);
                StateHasChanged();
            }

            DotNetReference = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await Module.InvokeVoidAsync("initialize", CanvasElement, ViewportElement, MetricsElement, DotNetReference, State.BuildGraphSnapshot(Localizer!));
            RendererReady = true;
            Busy = false;
            BusyMessage = string.Empty;
            await SaveSettingsAsync();
            StateHasChanged();
        }
        catch (Exception exception)
        {
            ShowError(exception);
            StateHasChanged();
        }
    }

    private void LoadSnapshots(string? language, string? requestedProfileId, string? requestedComparisonProfileId, bool compareEnabled)
    {
        Bootstrap = DataService.GetBootstrap(language);
        Localizer = new QuestMapLocalizer(Bootstrap);
        Profiles = DataService.GetProfiles(Bootstrap.Language);
        SelectedProfile = Profiles.FirstOrDefault(profile => profile.Id == requestedProfileId) ?? Profiles.FirstOrDefault();
        var requestedComparisonProfile = Profiles.FirstOrDefault(profile => profile.Id == requestedComparisonProfileId && profile.Id != SelectedProfile?.Id);
        var requestedComparisonMissing = compareEnabled && requestedComparisonProfileId is not null && requestedComparisonProfile is null;
        SelectedComparisonProfile = requestedComparisonProfile ?? Profiles.FirstOrDefault(profile => profile.Id != SelectedProfile?.Id);
        var topology = DataService.GetTopology(Bootstrap.Language);
        var profile = SelectedProfile is null ? null : DataService.GetProfileState(SelectedProfile.Id, Bootstrap.Language);
        var comparisonProfile = compareEnabled && !requestedComparisonMissing && SelectedComparisonProfile is not null
            ? DataService.GetProfileState(SelectedComparisonProfile.Id, Bootstrap.Language)
            : null;
        State.SetData(topology, profile, comparisonProfile);
        BusyMessage = Profiles.Count == 0 ? Localizer["profiles.none"] : Localizer["loading.initial"];
    }

    private async Task RefreshAsync()
    {
        if (Localizer is null) return;
        await ReloadAsync(Localizer.Language, SelectedProfile?.Id, SelectedComparisonProfile?.Id, State.CompareMode, Localizer["loading.refresh"]);
    }

    private async Task ChangeProfileAsync(string profileId)
    {
        if (Localizer is null) return;
        await ReloadAsync(Localizer.Language, profileId, SelectedComparisonProfile?.Id, State.CompareMode, Localizer["loading.profile"]);
    }

    private async Task ChangeComparisonProfileAsync(string profileId)
    {
        if (Localizer is null || !State.CompareMode) return;
        await ReloadAsync(Localizer.Language, SelectedProfile?.Id, profileId, true, Localizer["loading.profile"]);
    }

    private async Task SetCompareModeAsync(bool enabled)
    {
        if (Localizer is null || enabled && Profiles.Count < 2) return;
        await ReloadAsync(Localizer.Language, SelectedProfile?.Id, SelectedComparisonProfile?.Id, enabled, Localizer["loading.profile"]);
    }

    private async Task SwapProfilesAsync()
    {
        if (Localizer is null || !State.CompareMode || SelectedProfile is null || SelectedComparisonProfile is null) return;
        await ReloadAsync(Localizer.Language, SelectedComparisonProfile.Id, SelectedProfile.Id, true, Localizer["loading.profile"]);
    }

    private async Task ChangeLanguageAsync(string language) => await ReloadAsync(language, SelectedProfile?.Id, SelectedComparisonProfile?.Id, State.CompareMode, Localizer?["loading.topology"] ?? string.Empty);

    private async Task ReloadAsync(string? language, string? profileId, string? comparisonProfileId, bool compareEnabled, string message)
    {
        if (Localizer is null) return;
        var settings = State.CaptureSettings(profileId, language ?? Localizer.Language, comparisonProfileId, compareEnabled) with { SelectedProfileId = profileId, Language = language };
        Busy = true; BusyMessage = message; ErrorMessage = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            LoadSnapshots(language, profileId, comparisonProfileId, compareEnabled);
            State.ApplySettings(settings);
            SelectedProfile = Profiles.FirstOrDefault(profile => profile.Id == State.Profile?.ProfileId);
            SelectedComparisonProfile = Profiles.FirstOrDefault(profile => profile.Id == State.ComparisonProfile?.ProfileId)
                ?? Profiles.FirstOrDefault(profile => profile.Id == comparisonProfileId && profile.Id != SelectedProfile?.Id);
            if (Module is not null) await Module.InvokeVoidAsync("refresh", State.BuildGraphSnapshot(Localizer!));
            Busy = false; BusyMessage = string.Empty;
            await SaveSettingsAsync();
        }
        catch (Exception exception) { ShowError(exception); }
    }

    private Task SetShowAllFutureAsync(bool value) => ChangeViewAsync(() => State.SetShowAllFuture(value));
    private Task SetShowFinishedAsync(bool value) => ChangeViewAsync(() => State.SetShowFinished(value));
    private Task SetShowRepeatablesAsync(bool value) => ChangeViewAsync(() => State.SetShowRepeatables(value));
    private Task SetLevelCapAsync(int value) => ChangeViewAsync(() => State.SetLevelCap(value));
    private Task SetComparisonFilterAsync(QuestComparisonFilter value) => ChangeViewAsync(() => State.SetComparisonFilter(value));
    private Task SetSearchAsync(string value) => ChangeViewAsync(() => State.SetSearch(value));
    private Task SetTraderAsync(IReadOnlySet<string> value) => ChangeViewAsync(() => State.SetTraderFilter(value));
    private Task SetDrawerExpandedAsync(bool value) => ChangeViewAsync(() => State.SetInProgressExpanded(value));
    // Catch-up panel state is Blazor-rendered and absent from QuestGraphUpdate, so it
    // must not push a full graph payload over JS interop the way ChangeViewAsync does.
    private async Task SetCatchUpExpandedAsync(bool value)
    {
        State.SetCatchUpExpanded(value);
        await SaveSettingsAsync();
    }

    // The map filter narrows the graph as well as the panel, so unlike the panel's own
    // expand state it does need the renderer to resynchronise.
    private Task SetMapAsync(IReadOnlySet<string> value) => ChangeViewAsync(() => State.SetMapFilter(value));

    private async Task ChangeViewAsync(Action change)
    {
        change();
        await SynchronizeRendererAsync();
        await SaveSettingsAsync();
    }

    private async Task SelectFromDrawerAsync(string id)
    {
        if (State.FocusMode) State.ClearFocus();
        State.SelectQuest(id);
        await SynchronizeRendererAsync();
        if (Module is not null) await Module.InvokeVoidAsync("centerQuest", id);
        await SaveSettingsAsync();
    }

    /// <summary>
    /// Clicking a map or a chain narrows the graph exactly as the filter menu does, replacing
    /// the current selection rather than adding to it: the click means "show me this", and
    /// accumulating would need a second gesture to undo.
    /// </summary>
    private Task FilterToMapAsync(string mapId)
        => ChangeViewAsync(() => State.SetMapFilter(new HashSet<string>(new[] { mapId }, StringComparer.Ordinal)));

    private Task FilterToTraderAsync(string traderId)
        => ChangeViewAsync(() => State.SetTraderFilter(new HashSet<string>(new[] { traderId }, StringComparer.Ordinal)));

    /// <summary>
    /// Clicking a catch-up chain focuses it on the graph: select the earliest quest the
    /// player can actually act on, then activate focus so only that chain is drawn. Falls
    /// back to the first gated quest when nothing in the chain is actionable, so a
    /// fully-blocked chain still shows you where it picks up.
    /// </summary>
    private async Task FocusChainAsync(string traderId)
    {
        var chain = State.CatchUpChains.FirstOrDefault(item => item.TraderId == traderId);
        var target = chain?.NextQuests.FirstOrDefault() ?? chain?.GatedQuests.FirstOrDefault();
        if (target is null) return;

        if (State.FocusMode) State.ClearFocus();
        State.SelectQuest(target.QuestId);
        State.ActivateFocus();
        await SynchronizeRendererAsync();
        if (Module is not null) await Module.InvokeVoidAsync("centerQuest", target.QuestId);
        await SaveSettingsAsync();
    }

    private bool CoopExpanded;

    private Task SetCoopExpandedAsync(bool value)
    {
        CoopExpanded = value;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Loads full quest state for each pooled profile. Kept separate from compare mode: the
    /// pool feeds the co-op panel only, so switching players here never disturbs the pairwise
    /// graph comparison.
    /// </summary>
    private Task SetCoopPoolAsync(IReadOnlySet<string> profileIds)
    {
        var language = Bootstrap?.Language;
        var loaded = profileIds
            .Select(id => DataService.GetProfileState(id, language))
            .Where(state => state is not null)
            .Cast<ProfileStateDto>()
            .OrderBy(state => state.Nickname, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();
        State.SetPoolProfiles(loaded);
        return Task.CompletedTask;
    }

    private async Task SelectRelationAsync(string id)
    {
        State.SelectQuest(id);
        await SynchronizeRendererAsync();
        if (Module is not null) await Module.InvokeVoidAsync("centerQuest", id);
        await SaveSettingsAsync();
    }

    private Task FocusAsync() => ChangeViewAsync(State.ActivateFocus);
    private Task ClearFocusAsync() => ChangeViewAsync(State.ClearFocus);
    private Task ClearSelectionAsync() => ChangeViewAsync(State.ClearSelection);
    private async Task SetDetailTextTabAsync(QuestDetailTextTab value)
    {
        State.SetDetailTextTab(value);
        await SaveSettingsAsync();
    }
    private async Task FitAsync() { if (Module is not null) await Module.InvokeVoidAsync("fitVisible"); }
    private async Task ZoomAsync(double factor) { if (Module is not null) await Module.InvokeVoidAsync("zoom", factor); }

    [JSInvokable]
    public async Task OnQuestSelected(string? id)
    {
        if (id is null) State.ClearSelection(); else State.SelectQuest(id);
        await InvokeAsync(StateHasChanged);
        await SynchronizeRendererAsync();
        await SaveSettingsAsync();
    }

    [JSInvokable]
    public async Task OnQuestDoubleClicked(string id)
    {
        State.SelectQuest(id);
        State.ActivateFocus();
        await InvokeAsync(StateHasChanged);
        await SynchronizeRendererAsync();
        await SaveSettingsAsync();
    }

    [JSInvokable]
    public Task OnRendererFailed(string message)
    {
        ErrorMessage = message;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SynchronizeRendererAsync()
    {
        if (Module is not null && RendererReady) await Module.InvokeVoidAsync("synchronize", State.BuildGraphUpdate());
    }

    private async Task SaveSettingsAsync()
    {
        if (Localizer is null) return;
        var settings = State.CaptureSettings(SelectedProfile?.Id, Localizer.Language, SelectedComparisonProfile?.Id, State.CompareMode);
        try { await JavaScript.InvokeVoidAsync("localStorage.setItem", QuestMapSettingsStorage.PageStorageKey, QuestMapSettingsStorage.Serialize(settings)); }
        catch (JSException) { }
    }

    private async Task<QuestMapSettings?> LoadSettingsAsync()
    {
        try
        {
            var currentJson = await JavaScript.InvokeAsync<string?>("localStorage.getItem", QuestMapSettingsStorage.PageStorageKey);
            var previousJson = await JavaScript.InvokeAsync<string?>("localStorage.getItem", QuestMapSettingsStorage.PreviousStorageKey);
            var versionTwoJson = await JavaScript.InvokeAsync<string?>("localStorage.getItem", QuestMapSettingsStorage.VersionTwoStorageKey);
            var legacyJson = await JavaScript.InvokeAsync<string?>("localStorage.getItem", QuestMapSettingsStorage.LegacyStorageKey);
            return QuestMapSettingsStorage.Deserialize(currentJson, previousJson, versionTwoJson, legacyJson);
        }
        catch (JSException) { return null; }
    }

    private void ShowError(Exception exception)
    {
        ErrorMessage = exception.GetBaseException().Message;
        Busy = false;
        BusyMessage = string.Empty;
    }

    public async ValueTask DisposeAsync()
    {
        if (Module is not null)
        {
            try { await Module.InvokeVoidAsync("dispose"); } catch (JSDisconnectedException) { }
            await Module.DisposeAsync();
        }
        DotNetReference?.Dispose();
    }

}
