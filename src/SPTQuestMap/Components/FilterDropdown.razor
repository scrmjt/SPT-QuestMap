@using System.Collections.Generic
@using System.Linq

<div class="filter-dropdown" @onkeydown="HandleKeyDown">
    <button type="button" class="filter-dropdown-button" 
            disabled="@Disabled" 
            aria-expanded="@IsOpen.ToString().ToLowerInvariant()" 
            aria-haspopup="true" 
            @onclick="TogglePanel">
        @GetSummary()
    </button>
    @if (IsOpen && !Disabled)
    {
        <div class="filter-dropdown-panel">
            <input type="search" class="filter-dropdown-search" 
                   @bind="SearchTerm" 
                   @bind:event="oninput" 
                   placeholder="@SearchPlaceholder" />
            <div class="filter-dropdown-actions">
                <button type="button" @onclick="SelectAll">@SelectAllLabel</button>
                <button type="button" @onclick="Clear">@ClearLabel</button>
            </div>
            <ul class="filter-dropdown-list">
                @foreach (var item in GetVisibleItems())
                {
                    <li class="filter-dropdown-item" @key="item.Id">
                        <label>
                            <input type="checkbox" checked="@IsItemSelected(item.Id)" @onchange="@(e => ToggleItem(item.Id))" />
                            @if (item.ImageUrl != null)
                            {
                                <img src="@item.ImageUrl" alt="" />
                            }
                            @item.Label
                        </label>
                    </li>
                }
            </ul>
            <button type="button" class="filter-dropdown-close" @onclick="ClosePanel">@CloseLabel</button>
        </div>
    }
</div>

@code {
    public sealed record FilterDropdownItem(string Id, string Label, string? ImageUrl = null);

    [Parameter, EditorRequired]
    public IReadOnlyList<FilterDropdownItem> Items { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlySet<string> Selected { get; set; } = default!;

    [Parameter, EditorRequired]
    public string AllLabel { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SearchPlaceholder { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SelectAllLabel { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ClearLabel { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SelectedCountFormat { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CloseLabel { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<IReadOnlySet<string>> SelectionChanged { get; set; }

    private bool IsOpen = false;
    private string SearchTerm = string.Empty;

    private string GetSummary()
    {
        if (Selected.Count == 0)
        {
            return AllLabel;
        }
        else if (Selected.Count == 1)
        {
            var selectedItem = Items.FirstOrDefault(i => i.Id == Selected.First());
            return selectedItem?.Label ?? AllLabel;
        }
        else
        {
            return string.Format(SelectedCountFormat, Selected.Count);
        }
    }

    private IReadOnlyList<FilterDropdownItem> GetVisibleItems()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            return Items;
        }
        else
        {
            return Items.Where(i => i.Label.IndexOf(SearchTerm, StringComparison.OrdinalIgnoreCase) >= 0).ToList();
        }
    }

    private bool IsItemSelected(string id)
    {
        return Selected.Contains(id);
    }

    private void TogglePanel()
    {
        IsOpen = !IsOpen;
        if (!IsOpen)
        {
            SearchTerm = string.Empty;
        }
    }

    private async Task ToggleItem(string id)
    {
        var newSet = new HashSet<string>(Selected, StringComparer.Ordinal);
        if (newSet.Contains(id))
        {
            newSet.Remove(id);
        }
        else
        {
            newSet.Add(id);
        }
        await SelectionChanged.InvokeAsync(newSet);
    }

    private async Task SelectAll()
    {
        var visibleItems = GetVisibleItems();
        var newSet = new HashSet<string>(Selected, StringComparer.Ordinal);
        newSet.UnionWith(visibleItems.Select(i => i.Id));
        await SelectionChanged.InvokeAsync(newSet);
    }

    private async Task Clear()
    {
        await SelectionChanged.InvokeAsync(new HashSet<string>(StringComparer.Ordinal));
    }

    private void ClosePanel()
    {
        IsOpen = false;
        SearchTerm = string.Empty;
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && IsOpen)
        {
            ClosePanel();
        }
    }
}
