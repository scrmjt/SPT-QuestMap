@using System.Linq
@if (State.CompareMode)
{
    <aside class="catchup-panel @(State.CatchUpExpanded ? "expanded" : null)" aria-label="@Localizer["catchup.title"]">
        <button class="catchup-toggle" type="button" aria-expanded="@State.CatchUpExpanded.ToString().ToLowerInvariant()" title="@Localizer["catchup.title"]" @onclick="() => ExpandedChanged.InvokeAsync(!State.CatchUpExpanded)">
            <span class="catchup-title">@Localizer["catchup.title"]</span><span class="catchup-chevron" aria-hidden="true">@(State.CatchUpExpanded ? "›" : "‹")</span>
        </button>
        <div class="catchup-content">
            @if (State.SeriesProgress.Count > 0)
            {
                <h4 class="catchup-section-title">@Localizer["catchup.series.title"]</h4>
                <ol class="catchup-series">
                    @foreach (var series in State.SeriesProgress)
                    {
                        <li class="catchup-series-item">
                            <div class="catchup-series-header">
                                <strong>@series.SeriesName</strong>
                                <span class="catchup-series-total">/@series.TotalParts</span>
                            </div>
                            @RenderSeriesRow(State.Profile?.Nickname ?? State.PrimaryShortLabel, series.PrimaryFurthest, series.TotalParts, "primary")
                            @RenderSeriesRow(State.ComparisonProfile?.Nickname ?? State.ComparisonShortLabel, series.ComparisonFurthest, series.TotalParts, "comparison")
                            @if (series.CatchUpQuests.Count > 0)
                            {
                                <p class="catchup-series-lead">@Localizer.Format("catchup.series.needs", ("profile", series.BehindLabel))</p>
                                <ol class="catchup-series-quests">
                                    @foreach (var quest in series.CatchUpQuests)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => QuestSelected.InvokeAsync(quest.QuestId)">
                                                <span class="catchup-series-quest-name">@quest.Name</span>
                                                @if (quest.MapNames.Length > 0)
                                                {
                                                    <span class="catchup-series-quest-map">(@quest.MapNames)</span>
                                                }
                                            </button>
                                        </li>
                                    }
                                </ol>
                            }
                        </li>
                    }
                </ol>
            }
            @if (State.CatchUpChains.Count == 0)
            {
                <p class="catchup-empty">@Localizer["catchup.none"]</p>
            }
            @foreach (var chain in State.CatchUpChains.Where(item => item.Actionable))
            {
                @RenderChain(chain)
            }
            @{ var blockedChains = State.CatchUpChains.Where(item => !item.Actionable).ToArray(); }
            @if (blockedChains.Length > 0)
            {
                <details class="catchup-gated">
                    <summary>@Localizer.Format("catchup.gatedChains", ("count", blockedChains.Length))</summary>
                    @foreach (var chain in blockedChains)
                    {
                        @RenderChain(chain)
                    }
                </details>
            }
            @foreach (var player in State.PlayerCatchUpMaps.Where(entry => entry.Maps.Count > 0))
            {
                <h4 class="catchup-section-title">@Localizer.Format("catchup.playerMaps.title", ("profile", player.Label))</h4>
                <ol class="catchup-shared-maps">
                    @foreach (var map in player.Maps)
                    {
                        <li class="catchup-shared-map">
                            <button class="catchup-shared-map-header" type="button" title="@Localizer["catchup.map.filterHint"]"
                                    @onclick="() => MapFilterRequested.InvokeAsync(map.MapId)">
                                <strong>@map.MapName</strong>
                                <span class="catchup-gap">@Localizer.Format("catchup.playerMaps.count", ("count", map.Count))</span>
                            </button>
                            <ul class="catchup-shared-map-quests">
                                @foreach (var name in map.QuestNames)
                                {
                                    <li>@name</li>
                                }
                            </ul>
                        </li>
                    }
                </ol>
            }
        </div>
    </aside>
}

@code {
    private RenderFragment RenderChain(CatchUpChainDto chain) => @<section class="catchup-chain">
        <button class="catchup-trader" type="button" title="@Localizer.Format("catchup.gap.detail", ("primary", chain.PrimaryCompletedCount), ("comparison", chain.ComparisonCompletedCount))"
                @onclick="() => TraderFilterRequested.InvokeAsync(chain.TraderId)">
            <img src="@(chain.TraderImageUrl ?? "/files/trader/avatar/unknown.png")" alt="">
            <strong>@chain.TraderName</strong>
            <span class="catchup-gap">@Localizer.Format("catchup.gap", ("count", chain.Gap))</span>
        </button>
        <ol class="catchup-quests">
            @foreach (var quest in chain.NextQuests)
            {
                @RenderQuest(quest)
            }
        </ol>
        @if (chain.GatedQuests.Count > 0)
        {
            <details class="catchup-gated">
                <summary>@Localizer.Format("catchup.gatedQuests", ("count", chain.GatedQuests.Count))</summary>
                <ol class="catchup-quests">
                    @foreach (var quest in chain.GatedQuests)
                    {
                        @RenderQuest(quest)
                    }
                </ol>
            </details>
        }
    </section>;

    private RenderFragment RenderQuest(CatchUpQuestDto quest) => @<li class="catchup-quest @(quest.QuestId == State.SelectedId ? "selected" : null)">
        <button type="button" @onclick="() => QuestSelected.InvokeAsync(quest.QuestId)">
            <span class="catchup-quest-header">
                <span class="catchup-quest-name">@quest.Name</span>
                <span class="catchup-quest-location">@QuestSubtitle(quest)</span>
            </span>
            <span class="catchup-quest-state">@(Localizer[$"state.{quest.DisplayState}"])</span>
        </button>
    </li>;

    /// <summary>Location plus what the quest asks for, matching the Quests In Progress card.</summary>
    private string QuestSubtitle(CatchUpQuestDto quest)
    {
        var mix = State.ObjectiveMix(quest.QuestId);
        var objectives = mix.Count == 0
            ? string.Empty
            : " · " + string.Join(" · ", mix.Take(2).Select(entry => Localizer.Format($"objective.kind.{entry.Kind}", ("count", entry.Amount))));
        return quest.LocationName + objectives;
    }

    [Parameter, EditorRequired] public QuestMapPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public QuestMapLocalizer Localizer { get; set; } = default!;
    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }
    [Parameter] public EventCallback<string> QuestSelected { get; set; }

    /// <summary>Raised with a trader id when a chain is clicked, to filter the graph to it.</summary>
    [Parameter] public EventCallback<string> TraderFilterRequested { get; set; }

    /// <summary>Raised with a map id when a map is clicked, to filter the graph to it.</summary>
    [Parameter] public EventCallback<string> MapFilterRequested { get; set; }

    private RenderFragment RenderSeriesRow(string who, int furthest, int total, string role) => @<div class="catchup-series-row @role">
        <span class="catchup-series-who">@who</span>
        <span class="catchup-series-bar" role="img" aria-label="@(furthest == 0 ? Localizer["catchup.series.notStarted"] : $"{furthest} / {total}")">
            <span class="catchup-series-fill" style="width:@(total > 0 ? furthest * 100 / total : 0)%"></span>
        </span>
        <span class="catchup-series-value">@(furthest == 0 ? Localizer["catchup.series.notStarted"] : furthest.ToString())</span>
    </div>;
}
